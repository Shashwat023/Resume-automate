# ── Career-Ops Backend Environment ───────────────────────────────────
# Copy this file to .env and fill in the values.

# OpenRouter — powers Tier 1 (batched field mapping) and Tier 2 (Stagehand
# observe/act). Leave blank to run with LLM tiers disabled (Tier 0 only,
# every other field is left unfilled) — the app stays runnable without it.
OPENROUTER_API_KEY=

# 2captcha — solves CAPTCHAs encountered during automated submission.
# Leave blank to skip solving (a detected CAPTCHA is logged, then left
# unsolved) rather than failing the run.
TWOCAPTCHA_API_KEY=

# Dev safety gate — keep False until you deliberately want a real
# submission to go out. See README "Submission safety" section.
SUBMIT_ENABLED=False
