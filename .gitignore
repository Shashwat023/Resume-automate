# ==========================================
# Root .gitignore for resume-automate
# ==========================================

# --- System & IDEs ---
.DS_Store
Thumbs.db
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Logs & Debugging ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
backend/uvicorn.log

# --- Environment Configurations ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*
!*.example

# --- Frontend (Vite / Node) ---
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/local/

# --- Backend (Python / FastAPI) ---
# Virtual Environment
backend/.venv/
**/__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints

# Browser / Automation cache
backend/.chrome-profiles/

# Local Database & User Storage
backend/app.db
backend/storage/

# --- Temp & Personal scripts ---
cmd.txt
